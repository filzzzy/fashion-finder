name: "fashion_finder_vision"
platform: "onnxruntime_onnx"
max_batch_size: 64
input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [3, 224, 224]
  }
]
output [
  {
    name: "embedding"
    data_type: TYPE_FP32
    dims: [4096]
  }
]
instance_group [
  {
    count: 1
    kind: KIND_AUTO
  }
]
dynamic_batching {
  preferred_batch_size: [4, 8, 16]
  max_queue_delay_microseconds: 5000
}
